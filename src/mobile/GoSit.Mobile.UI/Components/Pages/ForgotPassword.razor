@page "/forgot-password"
@layout EmptyLayout
@inject GoSitApiClient Api

@*
    Requesting a reset link.

    The API's password-reset endpoint is always 204, whether or not the address has an
    account — see AccountRecoveryController. This screen has to stay just as silent, so
    there is one confirmation message and no branch on the result.
*@

<div style="display:flex;flex-direction:column;min-height:100dvh;
            padding:calc(env(safe-area-inset-top) + 3rem) 1.5rem
                    calc(env(safe-area-inset-bottom) + 2rem)">

    <div style="flex:1;display:flex;flex-direction:column;justify-content:center;max-width:26rem;width:100%;margin:0 auto;text-align:center">
        <h1 style="font-size:1.75rem;font-weight:800;margin-bottom:.375rem">Reset your password</h1>

        @if (_sent)
        {
            <p class="muted" style="margin:0 0 1.75rem">
                If that email has a GoSit account, a reset link is on its way.
            </p>
        }
        else
        {
            <p class="muted" style="margin:0 0 1.75rem">
                Enter the email on your account and we'll send you a reset link.
            </p>

            <EditForm Model="_form" OnValidSubmit="Submit" style="text-align:left">
                <div class="field">
                    <label class="field__label" for="email">Email address</label>
                    <InputText id="email" class="field__input" @bind-Value="_form.Email"
                               type="email" inputmode="email" autocomplete="username"
                               autocapitalize="none" placeholder="you@example.com" />
                </div>

                <button type="submit" class="btn btn--primary btn--block" disabled="@_busy">
                    @(_busy ? "Sending…" : "Send reset link")
                </button>
            </EditForm>
        }

        <a href="/login"
           style="display:inline-block;margin-top:1.5rem;color:var(--color-brand-primary);font-weight:600;text-decoration:none">
            Back to sign in
        </a>
    </div>
</div>

@code {
    private readonly Model _form = new();
    private bool _busy;
    private bool _sent;

    private sealed class Model
    {
        public string Email { get; set; } = "";
    }

    private async Task Submit()
    {
        _busy = true;

        try
        {
            await Api.PostAsync<object>("/api/v1/auth/password-reset", new { email = _form.Email });
        }
        catch (HttpRequestException)
        {
            // Still show the same confirmation below — surfacing network noise here would
            // leak the one bit this endpoint is designed to hide.
        }
        finally
        {
            _busy = false;
            _sent = true;
        }
    }
}
