@page "/account/about"

<AppShell Title="About" Subtitle="GoSit">
    <a href="/account" class="small muted"
       style="display:inline-flex;align-items:center;gap:.25rem;text-decoration:none;min-height:44px">
        <Icon Name="back" Size="18" /> Account
    </a>

    <div class="card">
        <p class="card__label">GoSit</p>
        <p class="card__meta" style="margin-top:.5rem">
            A trusted care marketplace connecting families with independent caregivers —
            child care, senior care, specialized support, and pet care.
        </p>
    </div>

    <div class="card">
        <p class="card__label">The marketplace, not the caregiver</p>
        <p class="card__meta" style="margin-top:.5rem">
            GoSit does not employ caregivers or directly provide care. It handles
            discovery, verification, booking, payments and trust and safety around a
            relationship a family and a caregiver form themselves.
        </p>
    </div>

    <div class="card">
        <p class="card__label">Legal</p>
        <p class="card__meta" style="margin-top:.5rem">
            GoSit is a trade name of 11419056 Canada Inc.
        </p>
    </div>

    <p class="small muted" style="margin-top:1rem;text-align:center">
        GoSit arranges non-medical care.
    </p>
</AppShell>
