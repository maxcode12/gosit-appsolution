@*
    One inline icon, by name.

    Drawn here rather than pulled from a font or an icon package: a handful of glyphs does
    not justify a dependency, and an icon font that fails to load leaves a screen of empty
    boxes. Every icon is aria-hidden and always sits beside a visible label, so nothing
    depends on recognising one.
*@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)PathFor(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    [Parameter] public int Size { get; set; } = 22;

    private static string PathFor(string name) => name switch
    {
        "today" => """<path d="M4 19V10M9 19V5M14 19v-6M19 19v-9" />""",
        "work" => """<rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 11h18" />""",
        "money" => """<rect x="2.5" y="6" width="19" height="12" rx="2" /><path d="M2.5 10h19" /><circle cx="17" cy="14" r="1.2" />""",
        "person" => """<circle cx="12" cy="8" r="3.6" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" />""",
        "pin" => """<path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.4" />""",
        "clock" => """<circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 1.8" />""",
        "check" => """<path d="M4.5 12.5 9.5 17.5 19.5 7" />""",
        "shield" => """<path d="M12 3 19 6v5.5c0 4.3-2.9 7.6-7 9.5-4.1-1.9-7-5.2-7-9.5V6Z" /><path d="m9 12 2 2 4-4" />""",
        "video" => """<rect x="2.5" y="6" width="13" height="12" rx="2" /><path d="m21.5 9-5 3 5 3Z" />""",
        "bell" => """<path d="M18 16v-5a6 6 0 0 0-12 0v5l-2 3h16Z" /><path d="M10 19a2 2 0 0 0 4 0" />""",
        "document" => """<path d="M6 2.5h9l3 3v16H6Z" /><path d="M15 2.5v3h3" /><path d="M9 12h6M9 16h6" />""",
        "wallet" => """<rect x="2.5" y="6" width="19" height="13" rx="2" /><path d="M2.5 10h19" /><circle cx="17.5" cy="14" r="1.2" />""",
        "chevron" => """<path d="m9 6 6 6-6 6" />""",
        "info" => """<circle cx="12" cy="12" r="8.5" /><path d="M12 11v5.5" /><circle cx="12" cy="8" r="0.1" stroke-width="2.5" />""",
        "back" => """<path d="M15 5 8 12l7 7" />""",
        "signout" => """<path d="M15 5H7a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8" /><path d="M15.5 12H21" /><path d="m18.5 9 3 3-3 3" />""",
        _ => "",
    };
}
